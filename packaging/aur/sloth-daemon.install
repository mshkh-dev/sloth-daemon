post_install() {
    cat << 'EOF'

>>> sloth-daemon installed.
>>> Edit /etc/sloth-daemon/sloth.toml (dry_run = true by default).
>>> Verify setup:
>>>   sloth-daemon --check
>>> Start or enable the service:
>>>   systemctl start sloth-daemon.service
>>>   systemctl enable sloth-daemon.service

EOF
}

post_upgrade() {
    post_install
}
